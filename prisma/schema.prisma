// مخطط قاعدة البيانات — حاويات برو (المرحلة الأولى)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===== الشركات والاشتراكات =====
enum CompanyStatus {
  ACTIVE    // نشطة
  SUSPENDED // موقوفة (يدوياً أو لانتهاء الاشتراك) — البيانات محفوظة
  TRIAL     // تجريبية
}

model Company {
  id         Int           @id @default(autoincrement())
  name       String
  status     CompanyStatus @default(TRIAL)
  expiresAt  DateTime // تاريخ انتهاء الاشتراك
  phone      String?
  notes      String?
  createdAt  DateTime      @default(now())
  branches    Branch[]
  users       User[]
  containers  Container[]
  orders      Order[]
  alerts      Alert[]
  employees    Employee[]
  attendance   Attendance[]
  payroll      Payroll[]
  vehicles     Vehicle[]
  maintenance  Maintenance[]
  dailyReports DailyReport[]
  expenses      Expense[]
  incomes       Income[]
  warehouses        Warehouse[]
  empTransactions   EmployeeTransaction[]
}

model Branch {
  id         Int         @id @default(autoincrement())
  name       String
  company    Company     @relation(fields: [companyId], references: [id])
  companyId  Int
  users      User[]
  containers Container[]
  orders     Order[]
}

// ===== المستخدمون والأدوار =====
enum Role {
  SUPER_ADMIN  // مدير المنصة (أنت)
  OWNER        // مدير الشركة
  BRANCH_MGR   // مدير فرع
  TRAFFIC_MGR  // مدير حركة
  DISPATCHER   // موزع عمليات
  ACCOUNTANT   // محاسب
  DRIVER       // سائق
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique // الدخول برقم الجوال
  password  String // مشفرة bcrypt
  role      Role
  language  String   @default("ar") // لغة السائق: ar, en, ur, hi, bn
  company   Company? @relation(fields: [companyId], references: [id])
  companyId Int?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  branchId  Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ===== الحاويات =====
enum ContainerStatus {
  IN_DEPOT     // بالمستودع
  SCHEDULED    // مجدولة للتسليم
  ON_SITE      // منزّلة بالموقع
  AWAIT_PICKUP // بانتظار الرفع
  IN_TRANSIT   // في الطريق
  MAINTENANCE  // صيانة
}

model Container {
  id          Int             @id @default(autoincrement())
  code        String
  lat          Float?
  size        String?
  status      ContainerStatus @default(IN_DEPOT)
  company     Company         @relation(fields: [companyId], references: [id])
  companyId   Int
  branch      Branch?         @relation(fields: [branchId], references: [id])
  branchId    Int?
  warehouse   Warehouse?      @relation(fields: [warehouseId], references: [id])
  warehouseId Int?
  orders      Order[]
  notes       String?

  @@unique([companyId, code])
  lat          Float?
  incomes     Income[]
}

// ===== أوامر العمل / الطلبات =====
enum OrderType {
  DROP          // إنزال
  PICKUP        // رفع نهائي
  SWAP          // تبديل (رفع + إنزال)
  MOVE          // نقل لموقع آخر
  PROJECT_CYCLE // دورة ضمن مشروع مستمر
}

enum OrderStatus {
  NEW       // جديد
  ASSIGNED  // مسند لسائق
  RECEIVED  // السائق استلم الطلب
  EN_ROUTE  // السائق في الطريق
  DONE      // منفذ
  CANCELLED // ملغي
}

model Order {
  id           Int         @id @default(autoincrement())
  type         OrderType   @default(DROP)
  status       OrderStatus @default(NEW)
  company      Company     @relation(fields: [companyId], references: [id])
  companyId    Int
  branch       Branch?     @relation(fields: [branchId], references: [id])
  branchId     Int?
  container    Container?  @relation(fields: [containerId], references: [id])
  containerId  Int?
  size         String? // الحجم المطلوب إن لم تُحدد حاوية بعد
  customerName String
  phone1       String // رقم العميل الأساسي
  phoneSite    String? // رقم المسؤول في موقع الحاوية
  phone3       String? // رقم إضافي اختياري
  lat          Float? // موقع العمل — يُلتقط من جوال مرسل الطلب
  lng          Float?
  address      String?
  contractNo   String? // برقم عقد أو بدون
  startDate    DateTime    @default(now())
  dueDate      DateTime? // تاريخ الاستحقاق — تعمل عليه الإشعارات
  alertMuted   Boolean     @default(false) // تعطيل إشعار الاستحقاق لهذا الطلب
  price           Float?
  notes           String?
  photos          String[]
  assignedTo      Int?           // معرف السائق المسند له
  collectedAmount Float?         // المبلغ المحصل من العميل (السائق)
  collectedAt     DateTime?      // وقت التحصيل
  collectedBy     Int?           // السائق الذي حصّل
  paymentMethod   String?        // cash | transfer
  accountingNote  String?        // ملاحظة المحاسب
  accountingAt    DateTime?      // وقت تسجيل المحاسب
  accountingBy    Int?           // المحاسب الذي سجّل
  createdAt    DateTime    @default(now())
  createdBy    Int?        // معرف المستخدم الذي أنشأ الطلب
  updatedBy    Int?        // معرف المستخدم الذي عدّل الطلب آخر مرة
}

// ===== التنبيهات (للإدارة) =====
model Alert {
  id           Int      @id @default(autoincrement())
  company      Company  @relation(fields: [companyId], references: [id])
  companyId    Int
  type         String // DUE_SOON | SUBSCRIPTION | ...
  message      String
  refOrderId   Int? // الطلب المرتبط إن وجد
  acknowledged Boolean  @default(false) // تم الاطلاع → يتوقف التكرار
  createdAt    DateTime @default(now())
}

// ===== الموارد البشرية =====
enum ShiftType {
  MORNING   // صباحي 8ص-4م
  EVENING   // مسائي 4م-12ص
  NIGHT     // ليلي 12ص-8ص
}

enum EmployeeStatus {
  ACTIVE     // على رأس العمل
  INACTIVE   // منتهي العمل
  LEAVE      // إجازة
  SICK       // إجازة مرضية
  SUSPENDED  // موقوف
}

model Employee {
  id         Int            @id @default(autoincrement())
  name       String
  role       String         // سائق، عامل، إداري، فني صيانة
  phone      String?
  shift      ShiftType      @default(MORNING)
  salary     Float          // الراتب الأساسي
  extra      Float          @default(0) // بدلات وإضافي
  hiredAt    String?        // تاريخ التعيين مثل 2023/04
  status     EmployeeStatus @default(ACTIVE)
  company    Company        @relation(fields: [companyId], references: [id])
  companyId  Int
  createdAt  DateTime       @default(now())
  createdBy  Int?
  attendance      Attendance[]
  payroll         Payroll[]
  vehicles        Vehicle[]
  transactions    EmployeeTransaction[]
}

model Attendance {
  id          Int       @id @default(autoincrement())
  employee    Employee  @relation(fields: [employeeId], references: [id])
  employeeId  Int
  company     Company   @relation(fields: [companyId], references: [id])
  companyId   Int
  date        DateTime  @default(now())
  checkIn     String?   // وقت الحضور
  checkOut    String?   // وقت الانصراف
  status      String    @default("none") // none | in | late | out | absent
  createdAt   DateTime  @default(now())
  createdBy   Int?      // من سجّل الحضور
}

model Payroll {
  id          Int       @id @default(autoincrement())
  employee    Employee  @relation(fields: [employeeId], references: [id])
  employeeId  Int
  company     Company   @relation(fields: [companyId], references: [id])
  companyId   Int
  month       String    // مثل 2026/06
  baseSalary  Float
  extra       Float     @default(0)
  absentDays  Int       @default(0)
  deduction   Float     @default(0)
  netSalary   Float
  paid        Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

// ===== الأسطول والصيانة =====
enum VehicleStatus {
  READY       // جاهزة
  MAINTENANCE // صيانة
  OUT_OF_SERVICE // خارج الخدمة
}

model Vehicle {
  id          Int           @id @default(autoincrement())
  type        String        // شاحنة هوك لودر، دينا، إلخ
  plate       String        // رقم اللوحة
  driver      Employee?     @relation(fields: [driverId], references: [id])
  driverId    Int?
  odometer    Float         @default(0)   // قراءة العداد الحالية
  lastOilAt   Float         @default(0)   // قراءة العداد عند آخر تغيير زيت
  oilInterval Float         @default(5000) // دورة تغيير الزيت بالكم
  status      VehicleStatus @default(READY)
  company     Company       @relation(fields: [companyId], references: [id])
  companyId   Int
  createdAt   DateTime      @default(now())
  createdBy   Int?
  maintenance Maintenance[]
}

model Maintenance {
  id          Int       @id @default(autoincrement())
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id])
  vehicleId   Int
  company     Company   @relation(fields: [companyId], references: [id])
  companyId   Int
  type        String    // تغيير زيت، فرامل، إطارات، إلخ
  details     String?
  cost        Float
  status      String    @default("مكتملة")
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
  createdBy   Int?
}

// ===== التقارير المالية اليومية =====
model DailyReport {
  id          Int      @id @default(autoincrement())
  company     Company  @relation(fields: [companyId], references: [id])
  companyId   Int
  date        DateTime @default(now())
  totalOrders Int      @default(0)
  cashIn      Float    @default(0)   // نقدي محصّل
  transferIn  Float    @default(0)   // تحويل محصّل
  totalIn     Float    @default(0)   // إجمالي الدخل
  salaryOut   Float    @default(0)   // رواتب مصروفة
  maintOut    Float    @default(0)   // صيانة
  otherOut    Float    @default(0)   // مصروفات أخرى
  netProfit   Float    @default(0)   // الصافي
  notes       String?
  createdBy   Int?
  createdAt   DateTime @default(now())
}

// ===== المستودعات =====
model Warehouse {
  id          Int         @id @default(autoincrement())
  name        String
  address     String?
  lat         Float?
  lng         Float?
  capacity    Int         @default(0)   // الطاقة الاستيعابية
  company     Company     @relation(fields: [companyId], references: [id])
  companyId   Int
  createdAt   DateTime    @default(now())
  containers  Container[]
}

// ===== المعاملات المالية للموظفين =====
enum TransactionType {
  BONUS_AMOUNT   // زيادة بالقيمة
  BONUS_DAYS     // زيادة بالأيام
  DEDUCTION      // خصم
  ADVANCE        // سلفة
  ADVANCE_REPAY  // سداد سلفة
  OVERTIME       // أوفر تايم
  PENALTY        // جزاء
}

model EmployeeTransaction {
  id          Int             @id @default(autoincrement())
  employee    Employee        @relation(fields: [employeeId], references: [id])
  employeeId  Int
  company     Company         @relation(fields: [companyId], references: [id])
  companyId   Int
  type        TransactionType
  amount      Float           // القيمة بالريال
  days        Float?          // عدد الأيام (للزيادة/الخصم بالأيام)
  month       String?         // الشهر المطبق عليه مثل 2026/06
  note        String?         // ملاحظة
  createdBy   Int?
  createdAt   DateTime        @default(now())
}

// ===== المصروفات =====
model Expense {
  id          Int      @id @default(autoincrement())
  company     Company  @relation(fields: [companyId], references: [id])
  companyId   Int
  date        DateTime @default(now())
  amount      Float
  category    ExpenseCategory
  description String?
  ref         String?  // رقم مرجعي (فاتورة، عقد...)
  createdBy   Int?
  createdAt   DateTime @default(now())
}

enum ExpenseCategory {
  RENT        // إيجار
  FUEL        // وقود
  MAINTENANCE // صيانة
  SALARY      // رواتب
  UTILITIES   // كهرباء/ماء
  OTHER       // أخرى
}

// ===== الدخل =====
model Income {
  id          Int         @id @default(autoincrement())
  company     Company     @relation(fields: [companyId], references: [id])
  companyId   Int
  date        DateTime    @default(now())
  amount      Float
  payType     PayType     // نقدي / تحويل / آجل
  category    String      @default("CONTAINER") // CONTAINER | OTHER
  description String?
  containerId Int?
  container   Container?  @relation(fields: [containerId], references: [id])
  driverId    Int?
  isPaid      Boolean     @default(true) // false للآجل
  paidAt      DateTime?
  createdBy   Int?
  createdAt   DateTime    @default(now())
}

enum PayType {
  CASH      // نقدي
  TRANSFER  // تحويل
  CREDIT    // آجل
}
